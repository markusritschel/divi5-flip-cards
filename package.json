{
  "name": "divi5-flip-cards",
  "version": "0.4.0",
  "private": true,
  "description": "Flip card module for Divi 5 with any Divi modules on the front and back.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20.18.1",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=development webpack -w --config webpack.config.js",
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "typecheck": "bash bin/typecheck.sh",
    "lint:php": "find divi5-flip-cards.php modules -name '*.php' -print0 | xargs -0 -n1 php -l",
    "zip": "npm run build && bash bin/make-zip.sh"
  },
  "devDependencies": {
    "@divi/module": "^1.0.7",
    "@divi/module-library": "^1.0.7",
    "@divi/module-utils": "^1.0.7",
    "@divi/style-library": "^1.0.5",
    "@divi/types": "^1.0.6",
    "@types/react": "18.3.1",
    "@wordpress/hooks": "^3.57.0",
    "@wordpress/i18n": "^4.57.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.1",
    "mini-css-extract-plugin": "^2.9.0",
    "react": "^18.2.0",
    "sass": "^1.77.0",
    "sass-loader": "^14.2.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
