{
  "name": "d5fc/flip-card",
  "d4Shortcode": "",
  "title": "Flip Card",
  "titles": "Flip Cards",
  "moduleIcon": "d5fc/module-flip-card",
  "moduleClassName": "d5fc_flip_card",
  "moduleOrderClassName": "d5fc_flip_card",
  "category": "module",
  "childModuleName": "d5fc/flip-card-face",
  "childModuleTitle": "Face",
  "childrenName": [
    "d5fc/flip-card-face"
  ],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Flip Card"
            }
          }
        }
      },
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "htmlAttributes": {},
          "text": {
            "component": {
              "props": {
                "fields": {
                  "color": {
                    "render": false
                  }
                }
              }
            }
          }
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "flip": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "advanced": {
          "preview": {
            "desktop": {
              "value": "both"
            }
          },
          "effect": {
            "desktop": {
              "value": "flip"
            }
          },
          "direction": {
            "desktop": {
              "value": "left"
            }
          },
          "duration": {
            "desktop": {
              "value": "600ms"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "preview": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.preview",
              "label": "Show in Builder",
              "description": "Choose how the card is shown while you edit it in the Visual Builder: both faces stacked, or the card showing its front or back. This has no effect on the live page.",
              "priority": 10,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "preset": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "both": {
                      "label": "Both (stacked)"
                    },
                    "front": {
                      "label": "Front"
                    },
                    "back": {
                      "label": "Back"
                    }
                  }
                }
              }
            }
          },
          "effect": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.effect",
              "label": "Effect",
              "description": "Choose how the back face replaces the front face: the card turns over, or the back face slides in over the front.",
              "priority": 15,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/button-options",
                "props": {
                  "options": {
                    "flip": {
                      "icon": "divi/animation-flip",
                      "label": "Flip"
                    },
                    "slide": {
                      "icon": "divi/animation-slide",
                      "label": "Slide"
                    }
                  },
                  "justified": true,
                  "allowClickToUnset": false
                }
              }
            }
          },
          "direction": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.direction",
              "label": "Direction",
              "description": "Choose the direction in which the card turns over or the back face moves.",
              "priority": 20,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "left": {
                      "label": "Left"
                    },
                    "right": {
                      "label": "Right"
                    },
                    "up": {
                      "label": "Up"
                    },
                    "down": {
                      "label": "Down"
                    }
                  }
                }
              }
            }
          },
          "duration": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.duration",
              "label": "Duration",
              "description": "How long the transition takes.",
              "priority": 30,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0,
                  "max": 3000,
                  "allowedUnits": [
                    "ms"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "inner": {
      "subName": "inner",
      "selectorSuffix": " .d5fc_flip_card__inner"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentFlip": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentFlip",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Flip"
          }
        }
      }
    }
  }
}
