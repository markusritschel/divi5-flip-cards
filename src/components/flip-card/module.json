{
  "name": "d5fc/flip-card",
  "d4Shortcode": "",
  "title": "Flip Card",
  "titles": "Flip Cards",
  "moduleIcon": "d5fc/module-flip-card",
  "moduleClassName": "d5fc_flip_card",
  "moduleOrderClassName": "d5fc_flip_card",
  "category": "module",
  "childModuleName": "d5fc/flip-card-face",
  "childModuleTitle": "Face",
  "childrenName": [
    "d5fc/flip-card-face"
  ],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Flip Card"
            }
          }
        }
      },
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "htmlAttributes": {},
          "text": {
            "component": {
              "props": {
                "fields": {
                  "color": {
                    "render": false
                  }
                }
              }
            }
          }
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "flip": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "advanced": {
          "preview": {
            "desktop": {
              "value": "both"
            }
          },
          "trigger": {
            "desktop": {
              "value": "hover"
            }
          },
          "backClick": {
            "desktop": {
              "value": "on"
            }
          },
          "backEscape": {
            "desktop": {
              "value": "on"
            }
          },
          "backLeave": {
            "desktop": {
              "value": "off"
            }
          },
          "hint": {
            "desktop": {
              "value": "off"
            }
          },
          "effect": {
            "desktop": {
              "value": "flip"
            }
          },
          "direction": {
            "desktop": {
              "value": "left"
            }
          },
          "duration": {
            "desktop": {
              "value": "600ms"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "preview": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.preview",
              "label": "Show in Builder",
              "description": "Choose how the card is shown while you edit it in the Visual Builder: both faces stacked, or the card showing its front or back. This has no effect on the live page.",
              "priority": 10,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "preset": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "both": {
                      "label": "Both (stacked)"
                    },
                    "front": {
                      "label": "Front"
                    },
                    "back": {
                      "label": "Back"
                    }
                  }
                }
              }
            }
          },
          "trigger": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.trigger",
              "label": "Trigger",
              "description": "Choose what turns the card over: hovering (tapping on touch screens), a click anywhere on the card (links and buttons on it still work), or a flip button in the corner.",
              "priority": 11,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/button-options",
                "props": {
                  "options": {
                    "hover": {
                      "icon": "d5fc/trigger-hover",
                      "label": "Hover"
                    },
                    "click": {
                      "icon": "d5fc/trigger-click",
                      "label": "Click"
                    },
                    "button": {
                      "icon": "d5fc/trigger-button",
                      "label": "Button"
                    }
                  },
                  "justified": true,
                  "allowClickToUnset": false
                }
              }
            }
          },
          "backClick": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.backClick",
              "label": "Flip Back on Second Click",
              "description": "Clicking the card (or the flip button) again turns it back to the front. Only for the click and flip button triggers.",
              "priority": 12,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "backEscape": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.backEscape",
              "label": "Flip Back with Escape",
              "description": "Pressing the Escape key turns the card back to the front. Only for the click and flip button triggers.",
              "priority": 13,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "backLeave": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.backLeave",
              "label": "Flip Back When the Pointer Leaves",
              "description": "The card turns back as soon as the mouse pointer leaves it. Only for the click and flip button triggers.",
              "priority": 14,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "hint": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.hint",
              "label": "Show Flip Hint",
              "description": "Shows a small flip icon in the corner of the card, which wiggles once when the card scrolls into view, so visitors see the card can be turned. Not shown with the flip button trigger.",
              "priority": 15,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "effect": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.effect",
              "label": "Effect",
              "description": "Choose how the back face replaces the front face: the card turns over (Flip), the back face slides in over the front, which stays visible behind it (Slide), the faces cross-fade (Fade), the front shrinks away as the back grows in (Zoom), or the card turns like a cube (Cube). With the slide, the back face covers the whole card unless you give it a height or width (Design > Sizing, e.g. auto to fit its content); for a frosted-glass look, give it a see-through background color and a backdrop blur (Design > Filters).",
              "priority": 16,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/button-options",
                "props": {
                  "options": {
                    "flip": {
                      "icon": "divi/animation-flip",
                      "label": "Flip"
                    },
                    "slide": {
                      "icon": "divi/animation-slide",
                      "label": "Slide"
                    },
                    "fade": {
                      "icon": "divi/animation-fade",
                      "label": "Fade"
                    },
                    "zoom": {
                      "icon": "divi/animation-zoom",
                      "label": "Zoom"
                    },
                    "cube": {
                      "icon": "d5fc/effect-cube",
                      "label": "Cube"
                    }
                  },
                  "justified": true,
                  "allowClickToUnset": false
                }
              }
            }
          },
          "direction": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.direction",
              "label": "Direction",
              "description": "Choose the direction in which the card turns over or the back face moves. Fade and Zoom don't move sideways; with a diagonal direction, Cube turns the card over like Flip.",
              "priority": 20,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/button-options",
                "props": {
                  "options": {
                    "left": {
                      "icon": "d5fc/direction-left",
                      "label": "Left"
                    },
                    "right": {
                      "icon": "d5fc/direction-right",
                      "label": "Right"
                    },
                    "up": {
                      "icon": "d5fc/direction-up",
                      "label": "Up"
                    },
                    "down": {
                      "icon": "d5fc/direction-down",
                      "label": "Down"
                    },
                    "up-left": {
                      "icon": "d5fc/direction-up-left",
                      "label": "Up Left"
                    },
                    "up-right": {
                      "icon": "d5fc/direction-up-right",
                      "label": "Up Right"
                    },
                    "down-left": {
                      "icon": "d5fc/direction-down-left",
                      "label": "Down Left"
                    },
                    "down-right": {
                      "icon": "d5fc/direction-down-right",
                      "label": "Down Right"
                    }
                  },
                  "justified": true,
                  "allowClickToUnset": false
                }
              }
            }
          },
          "duration": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentFlip",
              "attrName": "flip.advanced.duration",
              "label": "Duration",
              "description": "How long the transition takes.",
              "priority": 30,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "min": 0,
                  "max": 3000,
                  "allowedUnits": [
                    "ms"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "flipButton": {
      "type": "object",
      "selector": "{{selector}} > .d5fc_flip_card__toggle, {{selector}} > .d5fc_flip_card__hint",
      "default": {
        "advanced": {
          "position": {
            "desktop": {
              "value": "bottom-right"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "position": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designFlipButton",
              "attrName": "flipButton.advanced.position",
              "label": "Position",
              "description": "The corner of the card where the flip button and the flip hint sit. The button is visible with the flip button trigger, and with the other triggers while it has keyboard focus.",
              "priority": 10,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "top-left": {
                      "label": "Top Left"
                    },
                    "top-right": {
                      "label": "Top Right"
                    },
                    "bottom-left": {
                      "label": "Bottom Left"
                    },
                    "bottom-right": {
                      "label": "Bottom Right"
                    }
                  }
                }
              }
            }
          },
          "label": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designFlipButton",
              "attrName": "flipButton.advanced.label",
              "label": "Button Text",
              "description": "Optional text next to the flip icon, e.g. \"More\". Leave empty for a round icon button.",
              "priority": 20,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "icon": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designFlipButton",
              "attrName": "flipButton.advanced.icon",
              "label": "Icon",
              "description": "The icon on the flip button and the flip hint. Leave empty for the two turning arrows.",
              "priority": 25,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/icon-picker"
              }
            }
          }
        },
        "decoration": {
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designFlipButton",
              "attrName": "flipButton.decoration.background",
              "subName": "color",
              "label": "Background Color",
              "description": "Background color of the flip button and the flip hint.",
              "priority": 30,
              "render": true,
              "features": {
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/color-picker"
              }
            }
          },
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designFlipButtonText",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false,
                  "groupLabel": "Flip Button Text",
                  "fieldLabel": "Flip Button",
                  "fields": {
                    "color": {
                      "priority": 5,
                      "render": true
                    },
                    "headingLevel": {
                      "render": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "inner": {
      "subName": "inner",
      "selectorSuffix": " .d5fc_flip_card__inner"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentFlip": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentFlip",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Flip"
          }
        }
      },
      "designFlipButton": {
        "panel": "design",
        "priority": 15,
        "groupName": "designFlipButton",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Flip Button"
          }
        }
      },
      "designFlipButtonText": {
        "panel": "design",
        "priority": 16,
        "groupName": "designFlipButtonText",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Flip Button Text",
            "presetGroup": "divi/font"
          }
        }
      }
    }
  }
}
